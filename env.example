# Configuración de la aplicación Flask
SECRET_KEY=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
FLASK_ENV=production
FLASK_APP=main.py

# Configuración de base de datos
# Para SQLite (por defecto)
SQLALCHEMY_DATABASE=sqlite:////app/data/app.db

# Para PostgreSQL (opcional, descomenta si usas PostgreSQL)
# SQLALCHEMY_DATABASE=postgresql://usuario:password@db:5432/parqueadero_db

# Configuración de logging
LOG_LEVEL=INFO

# Configuración de dominio (para producción)
DOMAIN=tu-dominio.com
